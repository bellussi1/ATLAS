/dist
/generated
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log
yarn-error.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# Miscellaneous
/.angular/
/.wrangler/
/.claude/worktrees/
.playwright-mcp/
.playwright-cli/
output
.sass-cache/
/connect.lock
/coverage
/test-results
/playwright-report
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# Conteúdo de trabalho social (posts, imagens e pauta): fica local, fora do repositório público.
# Os scripts de automação são versionados; posts, imagens e calendário continuam locais.
docs/social/**
!docs/social/
!docs/social/linkedin/
!docs/social/linkedin/*.mjs

# System files
.DS_Store
Thumbs.db

# Corpos brutos da coleta Wikipedia: manifests são versionados; blobs ficam locais
# (publicam-se só as respostas JSON, via ingest:publish-raw).
scripts/ingestion/wiki-extract/raw/**/blobs/

# Credenciais e estado local de deploy: nunca no repositório (ele é público)
.env
.env.*
*.env
*.pem
*.key
.vercel

# Experimento RAG local (ambiente virtual, índices vetoriais e cache)
experiments/rag/.venv/
experiments/rag/data/
experiments/rag/.pytest_cache/
__pycache__/
*.pyc
*.egg-info/

# Saída das execuções de enriquecimento e avaliação (regenerável).
experiments/rag/eval/queues/
experiments/rag/eval/runs/

# Referências visuais de terceiros guardadas só localmente (repositório público)
.agents/skills/atlas-editorial-geometrico/references/feira-afro/
