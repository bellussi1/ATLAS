# Corpos brutos da coleta Wikipedia: manifests são versionados; blobs ficam locais
# (publicam-se só as respostas JSON, via ingest:publish-raw).
scripts/ingestion/wiki-extract/raw/**/blobs/

# Credenciais e estado local de deploy: nunca no repositório (ele é público)
.env
.env.*
*.env
*.pem
*.key
.vercel

# Capturas brutas do piloto de tradições: ficam locais até a publicação no worker de raw.
# Os manifestos referenciam blobs que o verify baixa; sem os blobs publicados, o CI falha.
scripts/ingestion/wiki-extract/raw/nazismo/
scripts/ingestion/wiki-extract/raw/stalinismo/
scripts/ingestion/wiki-extract/raw/trabalhismo/
