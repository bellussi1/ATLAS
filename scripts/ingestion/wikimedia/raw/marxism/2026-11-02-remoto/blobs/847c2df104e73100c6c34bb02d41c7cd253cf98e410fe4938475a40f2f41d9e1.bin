sh":"63a6ffa9bffdcec56b0521dd072c9ead0f875afb","datavalue":{"value":{"text":"\"Marx' crucial experience at Berlin was his  introduction to Hegel's philosophy,regnant there, and this adherence to the Young Hegelians.\"","language":"en"},"type":"monolingualtext"},"datatype":"monolingualtext"}]},"snaks-order":["P248","P304","P1683"]}]},{"mainsnak":{"snaktype":"value","property":"P737","hash":"5d112741b6a60b7688348bf3e43c220370645ddd","datavalue":{"value":{"entity-type":"item","numeric-id":76725,"id":"Q76725"},"type":"wikibase-entityid"},"datatype":"wikibase-item"},"type":"statement","id":"Q9061$4f2d2e28-433c-e9c5-5af7-066d5d513e78","rank":"normal"},{"mainsnak":{"snaktype":"value","property":"P737","hash":"48e09e993110458a93e48c5c29f3ae9c22870383","datavalue":{"value":{"entity-type":"item","numeric-id":76422,"id":"Q76422"},"type":"wikibase-entityid"},"datatype":"wikibase-item"},"type":"statement","id":"Q9061$8d688827-446f-2464-4e6d-7ed82ed6254d","rank":"normal","references":[{"hash":"6bf4bc54fd4d4d3d7834abe341bf98939efb50e8","snaks":{"P248":[{"snaktype":"value","property":"P248","hash":"900ac5f13c6416e686f0812b2a49be8403cd2be5","datavalue":{"value":{"entity-type":"item","numeric-id":56605560,"id":"Q56605560"},"type":"wikibase-entityid"},"datatype":"wikibase-item"}],"P304":[{"snaktype":"value","property":"P304","hash":"de0cbfdda810da133566c2119791ceafdcbd6cf4","datavalue":{"value":"531","type":"string"},"datatype":"string"}],"P1683":[{"snaktype":"value","property":"P1683","hash":"065d8568013b94fb8b3c056793680b2f1d93f26e","datavalue":{"value":{"text":"\"In 1841 Marx [...] was much influenced by the publication of ''Das Wesen des Christentums'' (1841; The Essence of Christianity) by Ludwig Feuerbach.\"","language":"en"},"type":"monolingualtext"},"datatype":"monolingualtext"}]},"snaks-order":["P248","P304","P1683"]},{"hash":"a99224b1992ec7e0e76b5ec5e65dfd9ecd0d45b3","snaks":{"P248":[{"snaktype":"value","property":"P248","hash":"59ce3a4d9b83207b83cdbc2a597bfbecf47887f3","datavalue":{"value":{"entity-type":"item","numeric-id":56628057,"id":"Q56628057"},"type":"wikibase-entityid"},"datatype":"wikibase-item"}],"P304":[{"snaktype":"value","property":"P304","hash":"0ea4eac35322666eed1739536e8e602fd089a811","datavalue":{"value":"37","type":"string"},"datatype":"string"}],"P1683":[{"snaktype":"value","property":"P1683","hash":"3dc524aca259604dc14c3eb2912a001343b151ad","datavalue":{"value":{"text":"\"Die Periode der Marxschen JUGENDWERKE (1840-1845), [...], kann [...] in zwei Momente untergliedert werden: a) [...] b) das rationalistisch-kommunit\u00e4re Moment der Jahre 1842-1845. [...]. Die Texte des zweiten Moments beruhen [...] auf der anthropologischen Problematik Feuerbachs.\" (Hv. i.O.)","language":"de"},"type":"monolingualtext"},"datatype":"monolingualtext"}]},"snaks-order":["P248","P304","P1683"]},{"hash":"77443138f835832e167f355173d4ad731896403d","snaks":{"P248":[{"snaktype":"value","property":"P248","hash":"633f5df208428c4d94d76fb74c94a9a310eb1268","datavalue":{"value":{"entity-type":"item","numeric-id":56627988,"id":"Q56627988"},"type":"wikibase-entityid"},"datatype":"wikibase-item"}],"P304":[{"snaktype":"value","property":"P304","hash":"5cb8fb50fc199964bf7ebc419d12f16371b6f1d6","datavalue":{"value":"771","type":"string"},"datatype":"string"}],"P1683":[{"snaktype":"value","property":"P1683","hash":"f8e220de9d2097b48d46e160c6a4b1131d9bccc0","datavalue":{"value":{"text":"\u201eMARX\u2019\u201c \u2013 fr\u00fche \u2013 \u201eanthropologischen Aussagen kn\u00fcpfen an Feuerbachs Konzeption vom Menschen als konkret-sinnl[iches] Gattungswesen an\u201c","language":"de"},"type":"monolingualtext"},"datatype":"monolingualtext"}]},"snaks-order":["P248","P304","P1683"]}]},{"mainsnak":{"snaktype":"value","property":"P737","hash":"b2f2ef0e6dbb74dbc9a653379b82b0605596fab7","datavalue":{"value":{"entity-type":"item","numeric-id":1170769,"id":"Q1170769"},"type":"wikibase-entityid"},"datatype":"wikibase-item"},"type":"statement","id":"Q9061$0e57dbaf-