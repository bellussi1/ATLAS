{"continue":{"iistart":"2008-09-06T14:21:26Z","continue":"||"},"query":{"pages":{"497250":{"pageid":497250,"ns":6,"title":"File:AdamSmith.jpg","imagerepository":"local","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0a/AdamSmith.jpg/1280px-AdamSmith.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1000,"thumbheight":1492,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/0/0a/AdamSmith.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0a/AdamSmith.jpg/1280px-AdamSmith.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1000,"height":1492,"srcset":"https://upload.wikimedia.org/wikipedia/commons/0/0a/AdamSmith.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/0/0a/AdamSmith.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:AdamSmith.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=497250","extmetadata":{"DateTime":{"value":"2008-09-06 14:43:06","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"AdamSmith","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Adam Smith (philosopher)|John Horsburgh|PD-Art (PD-old-100)|Files with derivative versions|CC-PD-Mark","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Profile of Adam Smith. The original depiction of Smith was created in 1787 by <a href=\"https://en.wikipedia.org/wiki/James_Tassie\" class=\"extiw\" title=\"w:James Tassie\">James Tassie</a> in the form of an enamel paste <a href=\"https://en.wikipedia.org/wiki/File:Smith_medallion_portrait.jpg\" class=\"extiw\" title=\"w:File:Smith medallion portrait.jpg\">medallion</a>.  Smith did not usually sit for his portrait, so a considerable number of engravings and busts of Smith were made not from observation but from the same enamel medallion produced by Tassie, an artist who <i>could</i> convince Smith to sit.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"Original work in 1787. Etching produced in 1811, 1828 or 1872","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external free\" href=\"http://www.library.hbs.edu/hc/collections/kress/kress_img/adam_smith2.htm\">http://www.library.hbs.edu/hc/collections/kress/kress_img/adam_smith2.htm</a>","source":"commons-desc-page"},"Artist":{"value":"Etching created by Cadell and Davies (1811), John Horsburgh (1828) or R.C. Bell (1872).","source":"commons-desc-page"},"Permission":{"value":"Any version is in the public domain in their country of origin and the United States as all are older than 100 years.","source":"commons-desc-page","hidden":""},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}}}]}}}}