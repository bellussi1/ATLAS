/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://gc.zgo.at https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://upload.wikimedia.org https://thumb.wikimedia.org https://atlas-content-delivery.atlas-bellussi.workers.dev https://*.goatcounter.com; font-src 'self'; connect-src 'self' https://atlas-content-delivery.atlas-bellussi.workers.dev https://*.goatcounter.com https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

# The build names scripts and styles by content hash, so they never change in place. Pages merges
# the headers of every matching rule, so a broad `/*.js` would add "immutable" to
# `/analytics-config.js` next to its `no-cache`; match only the hashed bundles instead.
/main-*.js
  Cache-Control: public, max-age=31536000, immutable
/chunk-*.js
  Cache-Control: public, max-age=31536000, immutable
/polyfills-*.js
  Cache-Control: public, max-age=31536000, immutable
/styles-*.css
  Cache-Control: public, max-age=31536000, immutable
# Fonts and brand files keep their names; cache them for long enough to help repeat visits.
/fonts/*
  Cache-Control: public, max-age=2592000
/brand/*
  Cache-Control: public, max-age=604800
/analytics-config.js
  Cache-Control: no-cache
/health.json
  Cache-Control: no-store
