{
  "name": "atlas",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "content:build": "node scripts/content/build-content.mjs",
    "content:fetch": "node scripts/content/fetch-content.mjs",
    "content:publish": "npm run content:build && node scripts/publish-r2.mjs",
    "ideology:new": "node scripts/content/new-ideology.mjs",
    "editorial:apply": "node scripts/content/apply-editorial-edition.mjs",
    "test:content": "node --test scripts/content/*.spec.mjs scripts/tradicao/*.spec.mjs scripts/security-headers.spec.mjs scripts/infra/*.spec.mjs",
    "tradicao": "node scripts/tradicao/pipeline.mjs",
    "tradicao:coverage": "node scripts/tradicao/coverage.mjs",
    "tradicao:reading": "node scripts/tradicao/reading.mjs",
    "tradicao:discover": "node scripts/tradicao/discover.mjs",
    "tradicao:extract": "node scripts/tradicao/extract.mjs",
    "tradicao:images": "node scripts/tradicao/images.mjs",
    "tradicao:imagens-relatorio": "node scripts/tradicao/image-coverage.mjs",
    "tradicao:onda": "node scripts/tradicao/wave.mjs",
    "tradicao:eval": "node scripts/tradicao/eval.mjs",
    "prestart": "npm run content:build",
    "prebuild": "npm run content:build && npm run content:fetch",
    "pretest": "npm run content:build",
    "prelint": "npm run content:build",
    "pretypecheck": "npm run content:build",
    "prewatch": "npm run content:build",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/security-headers.mjs && node scripts/seo.mjs && node scripts/infra/vercel-config.mjs",
    "ingest:liberalism": "node scripts/ingest-liberalism.mjs",
    "ingest:marxism": "node scripts/ingest-wikimedia-atlas.mjs marxism",
    "discover:marxism": "node scripts/discover-wikimedia.mjs marxismo",
    "discover:liberalism": "node scripts/discover-wikimedia.mjs liberalismo",
    "select:marxism": "node scripts/select-wikimedia.mjs marxismo",
    "select:liberalism": "node scripts/select-wikimedia.mjs liberalismo",
    "ingest:verify": "node scripts/verify-ingestion.mjs",
    "ingest:fetch-raw": "node scripts/ingestion/fetch-raw.mjs",
    "ingest:publish-raw": "node scripts/ingestion/publish-raw.mjs",
    "ingest:compress-raw": "node scripts/ingestion/compress-raw.mjs",
    "test:ingestion": "node --test scripts/ingestion/wikimedia/*.spec.mjs scripts/ingestion/wiki-extract/*.spec.mjs",
    "wiki:extract": "node scripts/wiki-extract.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && tsc --noEmit -p tsconfig.spec.json",
    "lint": "ng lint && npm run lint:architecture && npm run lint:biome && npm run format:check",
    "lint:architecture": "node --test scripts/architecture/eslint-boundaries.spec.cjs",
    "lint:biome": "biome lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,json}\" \"scripts/**/*.{mjs,js,cjs,json}\" \"e2e/**/*.{ts,js,mjs}\" \"*.{json,js,cjs,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css,json}\" \"scripts/**/*.{mjs,js,cjs,json}\" \"e2e/**/*.{ts,js,mjs}\" \"*.{json,js,cjs,mjs}\"",
    "preview": "node scripts/preview.mjs",
    "check:links": "node scripts/check-links.mjs",
    "infra:switch-cdn": "node scripts/infra/switch-content-domain.mjs",
    "infra:content-worker": "npx --yes wrangler@latest deploy --config scripts/infra/content-delivery.wrangler.toml",
    "infra:raw-lifecycle": "node scripts/infra/raw-lifecycle.mjs",
    "infra:raw-prune": "node scripts/infra/raw-prune.mjs",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "verify": "npm audit --omit=dev --audit-level=moderate && npm run lint && npm run typecheck && npm test && npm run test:ingestion && npm run test:content && npm run ingest:fetch-raw && npm run ingest:verify && npm run build && npm run check:links && npm run test:e2e"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.29",
    "d3-force": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.0",
    "@anthropic-ai/sdk": "^1.4.0",
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.4",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/d3-force": "^3.0.10",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^20.17.19",
    "angular-eslint": "21.4.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.3.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  }
}
