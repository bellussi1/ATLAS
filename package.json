{
  "name": "atlas",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/security-headers.mjs",
    "ingest:liberalism": "node scripts/ingest-liberalism.mjs",
    "ingest:marxism": "node scripts/ingest-wikimedia-atlas.mjs marxism",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && tsc --noEmit -p tsconfig.spec.json",
    "lint": "ng lint && npm run lint:biome && npm run format:check",
    "lint:biome": "biome lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,json}\" \"scripts/**/*.{mjs,js,json}\" \"e2e/**/*.{ts,js,mjs}\" \"*.{json,js,cjs,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css,json}\" \"scripts/**/*.{mjs,js,json}\" \"e2e/**/*.{ts,js,mjs}\" \"*.{json,js,cjs,mjs}\"",
    "preview": "node scripts/preview.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test:e2e": "playwright test"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.29",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.17.19",
    "angular-eslint": "21.4.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.3.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  }
}
