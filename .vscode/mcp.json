{
  // For more information, visit: https://angular.dev/ai/mcp
  "servers": {
    "angular-cli": {
      "command": "npx",
      "args": ["-y", "@angular/cli", "mcp"]
    },
    "firecrawl-local": {
      "command": "firecrawl-local",
      "args": ["mcp", "--public-only"],
      "env": {
        "FIRECRAWL_CLOUD": "off"
      }
    }
  }
}
